PRISM_PORT=8890
PRISM_BACKEND=robocasa
PRISM_DATA_ROOT=/opt/prism/shared/sessions
PRISM_FRONTEND_DIR=/opt/prism/current/web/dist
PRISM_TOKEN=replace-with-a-random-long-token
PRISM_MAX_SESSIONS=1
PRISM_ENABLE_EVALUATIONS=0
MUJOCO_GL=osmesa
PYOPENGL_PLATFORM=osmesa
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
NUMBA_NUM_THREADS=1
LP_NUM_THREADS=1
PYTHONUNBUFFERED=1
PYTHONUTF8=1
PYTHONPATH=/opt/prism/shared/vendor/robocasa:/opt/prism/shared/vendor/robosuite
PYNPUT_BACKEND=dummy
GALLIUM_DRIVER=llvmpipe
NUMBA_CACHE_DIR=/opt/prism/shared/cache
PYTHONDONTWRITEBYTECODE=1
NUMBA_DISABLE_JIT=1
PYTHONFAULTHANDLER=1
PYTHONHASHSEED=0
MESA_SHADER_CACHE_DIR=/opt/prism/shared/cache/mesa
XDG_CACHE_HOME=/opt/prism/shared/cache
